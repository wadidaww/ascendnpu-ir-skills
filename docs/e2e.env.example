# Example config for scripts/debug_e2e.sh — copy and edit, then:
#   scripts/debug_e2e.sh --config my-e2e.env --all

# --- connection ---
E2E_SERVER="user@10.0.0.42"          # E2E server (user@host)
E2E_PORT="22"
E2E_IDENTITY="$HOME/.ssh/id_ed25519" # ssh key (optional)
#E2E_JUMP="user@bastion.example.com" # ProxyJump / bastion (optional)
E2E_SET_ENV="/usr/local/Ascend/cann/set_env.sh"   # remote set_env.sh to source

# --- artifacts to push (step 0) ---
# Local dir holding the freshly-built binaries (auto-detected if empty):
#   bishengir-output/bin | build/install/bin | build/bin
E2E_ARTIFACT_BIN_DIR=""
E2E_ARTIFACT_LIB_DIR="build/install/lib"   # local dir with *.bc (optional)
E2E_REMOTE_BIN_DIR="/home/user/ascend-debug/bin"   # remote dest (prepended to PATH)
E2E_REMOTE_LIB_DIR="/home/user/ascend-debug/lib"   # remote dest for *.bc (optional)

# --- the E2E test (steps 1-3) ---
E2E_TEST="/home/user/triton-ascend/tests/test_add.py"  # remote path to python test
E2E_RUNNER="auto"                     # auto | pytest | python
#E2E_TEST_WORKDIR="/home/user/triton-ascend"   # remote cwd (default: test's dir)
E2E_PYTEST_ARGS="-k add"              # extra pytest args (runner=pytest)

# --- extraction (step 4) --- (defaults usually fine; override if needed)
#E2E_KERNEL_REGEX='[^[:space:]]+kernel\.mlir'   # ERE for the kernel.mlir path
#E2E_CMD_REGEX='bishengir-compile'              # ERE marking the compile line
#E2E_KERNEL="/tmp/dump/kernel.mlir"             # skip extraction; use this path

# --- local output (steps 5-6) ---
#E2E_LOCAL_DIR="e2e-debug/run1"        # default: e2e-debug/<timestamp>
